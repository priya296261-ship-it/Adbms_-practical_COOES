BEGIN
    DBMS_OUTPUT.PUT_LINE(UPPER('hello world'));
END;
BEGIN
    DBMS_OUTPUT.PUT_LINE(LOWER('HELLO WORLD'));
END;
BEGIN
    DBMS_OUTPUT.PUT_LINE(LENGTH('ORACLE'));
END;
BEGIN
    DBMS_OUTPUT.PUT_LINE(SUBSTR('ORACLE', 1, 3));
END;
BEGIN
    DBMS_OUTPUT.PUT_LINE(CONCAT('Hello ', 'World'));
END;
BEGIN
    DBMS_OUTPUT.PUT_LINE(REPLACE('I like Java', 'Java', 'SQL'));
END;
BEGIN
    DBMS_OUTPUT.PUT_LINE(INSTR('ORACLE', 'A'));
END;
BEGIN
    DBMS_OUTPUT.PUT_LINE(TRIM('  Hello  '));
END;

