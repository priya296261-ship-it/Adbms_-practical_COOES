COMMIT;

SELECT e.emp_id,
       e.emp_name,
       e.salary,
       d.dept_name
FROM employees e
INNER JOIN departments d
ON e.dept_id = d.dept_id;

SELECT e.emp_id,
       e.emp_name,
       d.dept_name
FROM employees e
LEFT JOIN departments d
ON e.dept_id = d.dept_id;

SELECT e.emp_name,
       d.dept_id,
       d.dept_name
FROM employees e
RIGHT JOIN departments d
ON e.dept_id = d.dept_id;

SELECT e.emp_name,
       e.dept_id AS employee_dept,
       d.dept_id AS department_dept,
       d.dept_name
FROM employees e
FULL OUTER JOIN departments d
ON e.dept_id = d.dept_id;

SELECT e.emp_name,
       e.salary,
       d.dept_name
FROM employees e
JOIN departments d
ON e.dept_id = d.dept_id
WHERE d.dept_name = 'IT';

SET SERVEROUTPUT ON;

BEGIN
    FOR r IN (
        SELECT e.emp_name,
               e.salary,
               d.dept_name
        FROM employees e
        JOIN departments d
        ON e.dept_id = d.dept_id
    )
    LOOP
        DBMS_OUTPUT.PUT_LINE(
            'Name: ' || r.emp_name ||
            ', Salary: ' || r.salary ||
            ', Department: ' || r.dept_name
        );
    END LOOP;
END;
















